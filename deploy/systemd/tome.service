# System unit for tome's MCP server (tome serve). Runs as the dedicated "tome"
# user, on loopback only: Caddy (deploy/Caddyfile) is the only way in.
#
#   sudo install -m 0644 deploy/systemd/tome.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tome
#
# Settings come from /etc/tome/tome.env (TOME_HOME, TOME_ALLOWED_HOSTS, ...).
# See deploy/README.md for the full setup.

[Unit]
Description=Tome knowledge bank (MCP over Streamable HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tome
Group=tome
EnvironmentFile=/etc/tome/tome.env
# git needs a home directory for ssh keys (backup push) and config.
Environment=HOME=/var/lib/tome
ExecStart=/opt/tome/.venv/bin/tome serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5

# /var/lib/tome holds the bank (and its .tome/ index). Created by systemd,
# owned by the service user.
StateDirectory=tome
StateDirectoryMode=0750
ReadWritePaths=/var/lib/tome
UMask=0027

# Hardening, as for nyttig's units. The server only writes the bank and
# talks to Caddy on loopback. It does fetch from nyttig when the nyttig
# tools are enabled, so network access is not restricted here.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
